# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL (production/Supabase):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/welfare_awareness
#
# SQLite (local dev fallback — used if DATABASE_URL is not set):
DATABASE_URL=sqlite:///./welfare_awareness.db

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production
API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── NLP ───────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
NLP_BATCH_SIZE=100

# ── File Uploads ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads
ALLOWED_EXTENSIONS=.csv,.json,.xlsx

# ── Scraping ──────────────────────────────────────────────────────────────
SCRAPER_USER_AGENT=WelfareAwarenessResearchBot/0.1 (+academic-research)
SCRAPER_DEFAULT_DELAY=2.0
SCRAPER_DEFAULT_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
